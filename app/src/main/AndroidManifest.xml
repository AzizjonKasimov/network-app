<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        A capture waits tens of seconds on the gateway. Without a foreground
        service the process is cached the moment the user leaves the app, and a
        cached process is frozen and eventually killed with the reply still in
        flight. The service keeps its foreground priority whether or not
        POST_NOTIFICATIONS is granted; the check-in asks for it, because its
        evening reminder is a notification and means nothing hidden.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        The check-in asks about numbers the user saves. Requested only when the
        user turns that on, and only names are read.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:name=".NetworkApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetworkApp"
        android:usesCleartextTraffic="false">

        <!--
            Single task, so a photo or link shared from another app, and the
            check-in reminder, land in the running app and its conversation
            rather than in a second copy of it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NetworkApp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".ai.AiRequestService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            Sees who wrote in Telegram, WhatsApp, KakaoTalk and LinkedIn, once
            the user grants notification access. Only the system can bind it.
        -->
        <service
            android:name=".checkin.ChatNotificationListener"
            android:exported="true"
            android:label="@string/chat_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
